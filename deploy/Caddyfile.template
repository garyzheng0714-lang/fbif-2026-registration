# FBIF Form Caddy 反向代理配置
# 用法: 复制到 /etc/caddy/Caddyfile，替换域名后 systemctl reload caddy
#
# 架构: [客户端] → 阿里云 CDN → Caddy (本机) → Nginx (本机:3001) → Docker API (蓝绿)
# Caddy 负责: HTTPS 证书 (Let's Encrypt) + 静态文件服务
# 静态文件目录: /var/www/fbif-form (生产)

{
    # CDN 节点作为反向代理连接本服务器，需信任 CDN 传来的 X-Forwarded-For 头。
    # 阿里云 CDN 官方 IP 段: https://help.aliyun.com/document_detail/27152.html
    # 使用 private_ranges 允许内网 + 配合 trusted_proxies 覆盖 CDN 出口 IP
    servers {
        trusted_proxies static private_ranges
    }
}

fbif2026ticket.foodtalks.cn {
    # Let's Encrypt ACME HTTP-01 挑战必须直接到达 Caddy，不能被 CDN 缓存。
    # 配置 CDN 缓存规则时须将 /.well-known/* 设为不缓存、直接回源。
    handle /.well-known/acme-challenge/* {
        file_server
    }

    # 静态文件服务 (被 CDN 缓存 30 天)
    handle /assets/* {
        root * /var/www/fbif-form
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    # SPA 入口 (CDN 不缓存, 每次回源)
    handle /* {
        root * /var/www/fbif-form
        try_files {path} /index.html
        file_server
        header Cache-Control "no-store"
    }

    # API 流量通过 Nginx 转发到蓝绿容器 (CDN 不缓存)
    handle /api/* {
        reverse_proxy localhost:3001 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /health {
        reverse_proxy localhost:3001
    }

    handle /metrics {
        reverse_proxy localhost:3001
    }
}

# Preview 环境通过 IP:3003 直接访问，无需 Caddy 条目。
