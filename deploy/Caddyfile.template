# FBIF 2026 观众注册系统 — Caddy 反向代理配置
# 用法: 复制到 /etc/caddy/Caddyfile，替换域名后 systemctl reload caddy
# 架构: [客户端] → 阿里云 CDN (可选) → Caddy (本机) → Nginx (3001) → Docker API (蓝绿)
# CDN 配置: 见 docs/cdn-setup-guide.md

{
    # 信任 CDN 节点传来的 X-Forwarded-For 头
    # 阿里云 CDN 出口 IP 段: https://help.aliyun.com/document_detail/27152.html
    servers {
        trusted_proxies static private_ranges
    }
}

(security_headers_common) {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }
}

(security_headers_prod) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

# ── 生产环境 ──────────────────────────────────────────────────────
fbif2026ticket.foodtalks.cn {
    import security_headers_common
    import security_headers_prod
    encode gzip zstd

    # Let's Encrypt ACME 挑战必须直达 Caddy，不能被 CDN 缓存
    handle /.well-known/acme-challenge/* {
        file_server
    }
    handle /api/* {
        reverse_proxy localhost:3001 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    # Nginx 直接响应 /healthz 返回 "ok"，不经过 Express
    handle /health {
        rewrite * /healthz
        reverse_proxy localhost:3001
    }
    handle /assets/* {
        root * /var/www/fbif-form
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }
    handle {
        root * /var/www/fbif-form
        try_files {path} /index.html
        file_server
        header Cache-Control "no-store"
    }
}

