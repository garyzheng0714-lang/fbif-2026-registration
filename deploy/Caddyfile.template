# FBIF 2026 观众注册系统 — Caddy 反向代理配置
# 用法: 复制到 /etc/caddy/Caddyfile，替换域名后 systemctl reload caddy
# 架构: [客户端] → 阿里云 CDN → Caddy (本机) → Nginx (3001) → Docker API (蓝绿)
# CDN 配置: 见 docs/cdn-setup-guide.md

{
    servers {
        trusted_proxies static private_ranges
    }
}

fbif2026ticket.foodtalks.cn {
    handle /.well-known/acme-challenge/* {
        file_server
    }
    handle /api/* {
        reverse_proxy localhost:3001
    }
    handle /health {
        rewrite * /healthz
        reverse_proxy localhost:3001
    }
    handle /assets/* {
        root * /var/www/fbif-form
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }
    handle {
        root * /var/www/fbif-form
        try_files {path} /index.html
        file_server
        header Cache-Control "no-store"
    }
}

:3003 {
    handle /api/* {
        reverse_proxy localhost:3101
    }
    handle /health {
        rewrite * /healthz
        reverse_proxy localhost:3101
    }
    handle /assets/* {
        root * /var/www/fbif-form-staging
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }
    handle {
        root * /var/www/fbif-form-staging
        try_files {path} /index.html
        file_server
        header Cache-Control "no-store"
    }
}
