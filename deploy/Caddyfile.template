# ── 测试环境（IP:3003 直连）──────────────────────────────────────
:3003 {
    import security_headers_common
    encode gzip zstd

    handle /api/* {
        reverse_proxy localhost:3101
    }
    handle /health {
        rewrite * /healthz
        reverse_proxy localhost:3101
    }
    handle /assets/* {
        root * /var/www/fbif-form-staging
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }
    handle {
        root * /var/www/fbif-form-staging
        try_files {path} /index.html
        file_server
        header Cache-Control "no-store"
    }
}
