# API published port on host machine.
# Recommended values:
# - production: 8080
# - staging: 8083
API_PORT=8080
API_PORT_INTERNAL=8080

# Dedicated data stores for this backend stack
POSTGRES_USER=fbif
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=fbif_form

# Frontend public origin (served by your existing NGINX)
WEB_ORIGIN=https://form.example.com
CSRF_COOKIE_SECURE=true

# Required application secrets
# Generate DATA_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=replace-with-32-byte-base64-key
DATA_HASH_SALT=replace-with-at-least-8-chars

# Feishu Bitable settings
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-with-secret
FEISHU_APP_TOKEN=app_token_xxx
FEISHU_TABLE_ID=tbl_xxx
FEISHU_FIELD_NAME=姓名
FEISHU_FIELD_PHONE=手机号（问卷题）
FEISHU_FIELD_TITLE=职位
FEISHU_FIELD_COMPANY=公司
FEISHU_FIELD_ID=证件号码
FEISHU_FIELD_IDENTITY=观展身份
FEISHU_FIELD_ID_TYPE=证件类型
FEISHU_FIELD_BUSINESS_TYPE=贵司的业务类型
FEISHU_FIELD_DEPARTMENT=您所处的部门
FEISHU_FIELD_PROOF_URL=专业观众证明（附件链接）
FEISHU_FIELD_CLICK_ID=
FEISHU_FIELD_CLICK_ID_SOURCE_KEY=
FEISHU_FIELD_SOURCE=
FEISHU_FIELD_TRACKING_PARAMS=访问跟踪参数
FEISHU_FIELD_TRACKING_ID=跟踪ID
FEISHU_FIELD_TRACKING_ID_TYPE=跟踪ID类型
FEISHU_FIELD_CLIENT_IP=ip
FEISHU_FIELD_ACTUAL_SUBMITTED_AT=实际提交时间
FEISHU_FIELD_CLIENT_REQUEST_ID=提交记录唯一值
FEISHU_SUBMISSION_SOURCE=正式环境

# Optional runtime toggles
RUN_DB_MIGRATE=true
RUN_WORKER=true
FEISHU_ALERT_WEBHOOK=
FEISHU_ALERT_ENABLED=true

# Optional OSS integration
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=
# OSS_PUBLIC_BASE_URL=
