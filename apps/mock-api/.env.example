MOCK_API_PORT=8080
WEB_ORIGIN=http://localhost:4173

# sync provider: feishu | mock
MOCK_API_SYNC_PROVIDER=feishu

# request simulation
MOCK_API_LATENCY_MS=120
MOCK_API_JITTER_MS=80
MOCK_API_SYNC_DELAY_MS=1200
MOCK_API_HTTP_500_RATE=0
MOCK_API_FAIL_RATE=0
MOCK_API_FORCE_SYNC_STATUS=

# upload settings (multipart/form-data)
MOCK_API_UPLOAD_DIR=/tmp/fbif-form-uploads
MOCK_API_MAX_UPLOAD_MB=50
MOCK_API_MAX_UPLOAD_FILES=5

FEISHU_APP_ID=cli_a9f7f8703778dcee
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=<YOUR_FEISHU_APP_TOKEN>
FEISHU_TABLE_ID=tbl0CQ74guMS1IDd

# optional field map override
FEISHU_FIELD_NAME=姓名（问卷题）
FEISHU_FIELD_PHONE=手机号（问卷题）
FEISHU_FIELD_TITLE=职位（问卷题）
FEISHU_FIELD_COMPANY=公司（问卷题）
FEISHU_FIELD_ID=证件号码（问卷题）
FEISHU_FIELD_IDENTITY=观展身份
FEISHU_FIELD_ID_TYPE=证件类型（问卷题）
FEISHU_FIELD_PROOF=上传专业观众证明

# These fields don't exist in the default table; leave empty unless you add them.
FEISHU_FIELD_SUBMITTED_AT=
FEISHU_FIELD_SYNC_STATUS=

# attachment upload location for bitable
# Defaults: parent_type=bitable_file, parent_node=FEISHU_APP_TOKEN
FEISHU_MEDIA_PARENT_TYPE=bitable_file
FEISHU_MEDIA_PARENT_NODE=
